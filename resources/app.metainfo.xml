<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.github.cosmic_media_now_playing_applet</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Now Playing</name>
  <summary>A COSMIC panel applet that displays the currently playing media track</summary>

  <!-- Links this component to the installed .desktop file. Without it a
       desktop-application component is invalid, and software centers can't
       reliably match the metadata to the installed application. -->
  <launchable type="desktop-id">com.github.cosmic_media_now_playing_applet.desktop</launchable>

  <description>
    <p>
      Shows the currently playing media track on your COSMIC desktop panel using MPRIS.
      Displays album art and the track title, with inline playback controls on hover and
      a popup offering a seekable progress bar, playback controls, a player selector, and
      a one-shot "pause before playing next track" switch.
    </p>
    <p>
      Works with any MPRIS-compatible player, including Spotify, web players in Firefox
      and Chromium, VLC, Rhythmbox, and Amberol.
    </p>
  </description>

  <categories>
    <category>System</category>
    <category>Audio</category>
  </categories>

  <keywords>
    <keyword>media</keyword>
    <keyword>music</keyword>
    <keyword>mpris</keyword>
    <keyword>now playing</keyword>
    <keyword>applet</keyword>
  </keywords>

  <url type="homepage">https://github.com/stldave314/cosmic-media-now-playing-applet</url>
  <url type="bugtracker">https://github.com/stldave314/cosmic-media-now-playing-applet/issues</url>

  <developer id="io.github.stldave314">
    <name>stldave314</name>
  </developer>

  <content_rating type="oars-1.1"/>

